---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const friends = [
    {
        title: "Qlexander",
        imgurl: "/qlexander.webp",
        desc: "Stay Hungry, Stay Foolish.",
        siteurl: "https://qlexander.cn/",
        relationship: "Relative",
    },
    {
        title: "CrisgLea",
        imgurl: "https://pub-5ba3d0ad40a24ef592534696f7db2ba7.r2.dev/avatar.png",
        desc: "即使上升的终点是破灭，也总想传递些什么",
        siteurl: "https://www.crisglea.top/",
        relationship: "College Mate",
    },
];

const myInfo = [
    ["title", "Young", "昵称"],
    ["imgurl", "https://youngjr.cn/avatar.png", "头像"],
    ["desc", "I wanna live I don't wanna die", "网站描述"],
    ["siteurl", "https://youngjr.cn/", "网站链接"],
].map(([key, value, note]) => ({
    line: key + ": " + JSON.stringify(value) + ",",
    note,
}));
const copyText = myInfo.map(({ line }) => line).join("\n");
---

<MainGridLayout title="友链" description="友情链接与本站信息">
    <section class="card-base friends-page" aria-label="友情链接">
        <div class="friends-grid">
            {friends.map((friend) => (
                <a class="friend" href={friend.siteurl} target="_blank" rel="noopener noreferrer">
                    <img src={friend.imgurl} alt="" width="100" height="100" class="avatar" />
                    <div class="info">
                        <h2>{friend.title}</h2>
                        <p>{friend.desc}</p>
                        {friend.relationship && <p>{friend.relationship}</p>}
                    </div>
                    <span class="arrow" aria-hidden="true">
                        <Icon name="material-symbols:chevron-right-rounded" />
                    </span>
                </a>
            ))}
        </div>
        <div class="exchange">
            <p>如想交换本站友情链接，请<a href="https://github.com/YoungJR1/my-blog/issues/new?title=申请交换友链">联系我</a>并提供以下格式的信息：</p>
            <friend-link-info>
                <div class="code-scroll" tabindex="0" aria-label="本站友链信息">
                    <ol>{myInfo.map(({ line, note }) => <li><code>{line.padEnd(46)}<span>// {note}</span></code></li>)}</ol>
                </div>
                <button type="button" data-copy={copyText} aria-label="复制本站友链信息" title="复制">
                    <Icon name="material-symbols:content-copy-rounded" />
                </button>
                <span class="feedback" role="status"></span>
            </friend-link-info>
        </div>
    </section>
</MainGridLayout>

<script>
    if (!customElements.get("friend-link-info")) {
        customElements.define("friend-link-info", class extends HTMLElement {
            connectedCallback() {
                const button = this.querySelector("button");
                const status = this.querySelector('[role="status"]');
                if (!button || !status) return;
                button.onclick = async () => {
                    try {
                        await navigator.clipboard.writeText(button.dataset.copy ?? "");
                        status.textContent = "已复制";
                    } catch {
                        status.textContent = "请选中并复制";
                    }
                };
            }
        });
    }
</script>

<style>
    .friends-page { padding: clamp(1.25rem, 4vw, 2.25rem); }
    .friends-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 1.25rem; }
    .friend { display: grid; grid-template-columns: min(26%, 6.25rem) minmax(0, 1fr) 2rem; gap: .85rem; text-decoration: none; color: inherit; }
    .avatar { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: .45rem; }
    .info { padding-block: .15rem; overflow-wrap: anywhere; }
    .info h2 { font-size: 1rem; font-weight: 700; margin-bottom: .25rem; }
    .info p { font-size: .85rem; line-height: 1.45; opacity: .7; }
    .arrow { display: grid; place-items: center; border-radius: .45rem; color: var(--primary); background: var(--btn-regular-bg); font-size: 1.5rem; }
    .friend:hover .arrow, .friend:focus-visible .arrow { background: var(--btn-regular-bg-hover); }
    .exchange { border-top: 1px dashed var(--line-divider); margin-top: 1rem; padding-top: clamp(1.5rem, 4vw, 2.5rem); font-size: .9rem; }
    .exchange a { color: var(--primary); text-decoration: underline; }
    friend-link-info { display: block; position: relative; margin-top: 1.5rem; padding: .85rem; border-radius: .75rem; color: #f3eef0; background: #1b1519; }
    .code-scroll { overflow: auto; margin-right: 2.4rem; }
    ol { margin: 0; padding-left: 2rem; list-style: decimal; font: .8rem/1.7 monospace; }
    li { white-space: pre; }
    li::marker { color: #a69aa2; }
    code span { color: #bdb2b9; }
    button { position: absolute; top: .5rem; right: .5rem; padding: .45rem; background: #4c454a; color: white; border-radius: .4rem; }
    .feedback { position: absolute; top: .5rem; right: 2.7rem; background: #1b1519; }
    @media (max-width: 650px) { .friends-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
